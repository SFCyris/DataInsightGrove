<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>DataInsightGrove</string>
    <key>CFBundleDisplayName</key>
    <string>DataInsightGrove</string>
    <key>CFBundleIdentifier</key>
    <string>local.datainsightgrove</string>
    <key>CFBundleVersion</key>
    <string>0.0.1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleExecutable</key>
    <string>DataInsightGrove</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- The WKWebView talks to a local dev server over plain HTTP. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Repo path baked in at build time so the app can find dig-start.sh / dig-stop.sh. -->
    <key>DIGRepoRoot</key>
    <string>__DIG_REPO_ROOT__</string>

    <!-- Copyright + trademark notice: shows in the app's "About" panel and in
         the Finder Get Info window. Establishes prior art via the bundle. -->
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Sebastian Cyris. DataInsightGrove™ and the 🌳 logo are unregistered trademarks of Sebastian Cyris. AGPL-3.0-or-later. Source: https://github.com/SFCyris/DataInsightGrove</string>
    <key>CFBundleGetInfoString</key>
    <string>DataInsightGrove™ 0.0.1 — self-hosted data preparation. AGPL-3.0. https://github.com/SFCyris/DataInsightGrove</string>
</dict>
</plist>
