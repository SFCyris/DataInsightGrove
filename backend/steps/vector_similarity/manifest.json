{
  "id": "vector_similarity",
  "version": "1.0.0",
  "label": "🧭 Vector similarity",
  "description": "Compute similarity / distance between two vector columns. Cosine for embeddings (range [-1, 1]; 1 = identical), dot product for raw scoring, Euclidean / Manhattan for spatial distance.",
  "category": "derive",
  "engine": { "primary": "sql", "browser": "sql", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "leftColumn": { "type": "column_ref", "label": "Left vector column",  "columnFrom": "in", "required": true },
    "rightColumn": { "type": "column_ref", "label": "Right vector column", "columnFrom": "in", "required": true },
    "metric": {
      "type": "enum",
      "label": "Metric",
      "enumValues": ["cosine", "dot", "euclidean", "manhattan"],
      "default": "cosine",
      "required": true,
      "help": "cosine: angular similarity, best for embeddings (range [-1, 1]). dot: raw inner product (use when vectors are normalized). euclidean: L2 distance, lower = closer. manhattan: L1 distance."
    },
    "outputColumn": {
      "type": "string",
      "label": "Output column name",
      "default": "similarity",
      "required": true
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["vector", "embedding", "similarity", "knn", "ml", "derive"],
  "requires": [{"kind": ["vector", "string", "array"], "min": 2}],
  "aliases": ["cosine", "knn", "nearest neighbors", "similarity", "dot product"]
}
