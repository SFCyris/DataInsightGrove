{
  "id": "replace_text",
  "version": "1.0.0",
  "label": "🔤 Replace text",
  "description": "Find-and-replace inside a string column. Supports plain substring or regex.",
  "category": "clean",
  "engine": { "primary": "sql", "browser": "sql", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "column": { "type": "column_ref", "label": "Column", "columnFrom": "in", "required": true },
    "find":   { "type": "string", "label": "Find", "required": true },
    "replace":{ "type": "string", "label": "Replace with", "default": "" },
    "regex":  { "type": "boolean", "label": "Treat 'find' as regex", "default": false }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["string", "clean", "regex"]
}
