{
  "id": "coalesce_columns",
  "version": "1.0.0",
  "label": "🪢 Coalesce columns",
  "description": "First non-null wins. Combine multiple columns into one, dropping the originals if requested.",
  "category": "clean",
  "engine": { "primary": "sql", "browser": "sql", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "columns": { "type": "column_refs", "label": "Columns (in priority order)", "columnFrom": "in", "required": true },
    "as":      { "type": "string", "label": "New column name", "required": true },
    "drop":    { "type": "boolean", "label": "Drop the source columns", "default": false }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["coalesce", "merge", "null"]
}
