{
  "id": "seasonal_decompose",
  "version": "1.0.0",
  "label": "\ud83d\udd02 Seasonal decomposition",
  "description": "Decompose a time series into trend, seasonal, and residual components (additive or multiplicative). Adds 3 new columns and renders a 4-panel plot.",
  "category": "model",
  "engine": {
    "primary": "polars",
    "browser": "none",
    "deterministic": true
  },
  "io": {
    "inputs": {
      "min": 1,
      "max": 1,
      "ports": [
        "in"
      ]
    },
    "outputs": {
      "min": 1,
      "max": 1,
      "ports": [
        "out"
      ]
    }
  },
  "params": {
    "time_column": {
      "type": "column_ref",
      "label": "Time column",
      "columnFrom": "in",
      "required": true
    },
    "value_column": {
      "type": "column_ref",
      "label": "Value column",
      "columnFrom": "in",
      "required": true
    },
    "model": {
      "type": "enum",
      "label": "Model",
      "enumValues": [
        "additive",
        "multiplicative"
      ],
      "default": "additive",
      "required": true,
      "help": "Use 'additive' if seasonal amplitude is roughly constant; 'multiplicative' if it grows/shrinks with the level."
    },
    "period": {
      "type": "integer",
      "label": "Seasonal period",
      "default": 0,
      "min": 0,
      "help": "Number of observations per season (e.g. 7 for daily data with weekly seasonality, 12 for monthly with yearly). 0 = auto-detect from time column frequency."
    },
    "render": {
      "type": "boolean",
      "label": "Render decomposition plot",
      "default": true
    },
    "title": {
      "type": "string",
      "label": "Title",
      "default": "Seasonal decomposition"
    }
  },
  "preview": {
    "rowImpact": "preserves",
    "schemaImpact": "modifies"
  },
  "tags": [
    "time-series",
    "seasonal",
    "decompose",
    "trend"
  ],
  "requires": [{"kind": "temporal"}, {"kind": "numeric"}],
  "aliases": ["trend", "seasonality", "decomposition", "stl"]
}