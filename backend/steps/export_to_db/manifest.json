{
  "id": "export_to_db",
  "version": "1.0.0",
  "label": "🗃 Export to database",
  "description": "Write the data to a SQL database table. Supports SQLite, Postgres, MySQL via standard URIs.",
  "category": "output",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "uri": {
      "type": "string",
      "label": "Connection URI",
      "required": true,
      "help": "e.g. sqlite:///path/to.db · postgresql://user:pass@host/db · mysql://user:pass@host/db"
    },
    "table": {
      "type": "string",
      "label": "Table name",
      "required": true
    },
    "if_exists": {
      "type": "enum",
      "label": "If the table exists",
      "enumValues": ["append", "replace", "fail"],
      "default": "append",
      "required": true
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["export", "sink", "database", "sql"]
}
