{
  "id": "union",
  "version": "1.0.0",
  "label": "🔀 Union",
  "description": "Stack two datasets vertically. Schemas should match by column name.",
  "category": "combine",
  "engine": { "primary": "sql", "browser": "sql", "deterministic": true },
  "io": {
    "inputs": { "min": 2, "max": 2, "ports": ["top", "bottom"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "distinct": {
      "type": "boolean",
      "label": "Drop duplicates (UNION vs UNION ALL)",
      "default": false
    }
  },
  "preview": { "rowImpact": "may_grow", "schemaImpact": "preserves" },
  "tags": ["union", "concat"],
  "aliases": ["append", "concat", "stack", "concatenate"]
}
