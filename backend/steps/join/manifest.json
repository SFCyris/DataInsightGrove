{
  "id": "join",
  "version": "1.0.0",
  "label": "🔗 Join",
  "description": "Combine two datasets on matching key columns. Supports inner, left, right, full outer.",
  "category": "combine",
  "engine": { "primary": "sql", "browser": "sql", "deterministic": true },
  "io": {
    "inputs": { "min": 2, "max": 2, "ports": ["left", "right"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "how": {
      "type": "enum",
      "label": "Join type",
      "enumValues": ["inner", "left", "right", "full"],
      "default": "inner",
      "required": true
    },
    "on": {
      "type": "array",
      "label": "Key pairs",
      "items": {
        "type": "object",
        "label": "Key",
        "properties": {
          "left":  { "type": "column_ref", "label": "Left",  "columnFrom": "left",  "required": true },
          "right": { "type": "column_ref", "label": "Right", "columnFrom": "right", "required": true }
        }
      }
    }
  },
  "preview": { "rowImpact": "may_grow", "schemaImpact": "rebuilds" },
  "tags": ["join", "merge"]
}
