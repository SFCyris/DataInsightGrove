{
  "id": "pivot_longer",
  "version": "1.0.0",
  "label": "↕️ Pivot longer",
  "description": "Stack multiple value columns into key/value rows. The inverse of pivot wider.",
  "category": "aggregate",
  "engine": { "primary": "sql", "browser": "sql", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "id": {
      "type": "column_refs",
      "label": "Identifier columns (kept as-is)",
      "columnFrom": "in",
      "required": true
    },
    "value_cols": {
      "type": "column_refs",
      "label": "Columns to stack",
      "columnFrom": "in",
      "required": true
    },
    "names_to":  { "type": "string", "label": "Names column",  "default": "name" },
    "values_to": { "type": "string", "label": "Values column", "default": "value" }
  },
  "preview": { "rowImpact": "may_grow", "schemaImpact": "rebuilds" },
  "tags": ["pivot", "unpivot", "long", "tidy"],
  "requires": [{"kind": "any", "min": 2}],
  "aliases": ["melt", "unpivot", "wide to long"]
}
