{
  "id": "pie_donut",
  "version": "1.0.0",
  "label": "🥧 Pie / donut chart",
  "description": "Classic part-to-whole pie or donut. Each row contributes one slice; slice angle proportional to the value column. Donut variant has a hole in the middle for a center label.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "labelColumn": { "type": "column_ref", "label": "Label column", "columnFrom": "in", "required": true },
    "valueColumn": { "type": "column_ref", "label": "Value column", "columnFrom": "in", "required": true,
      "columnTypes": ["integer", "double"] },
    "variant": { "type": "enum", "label": "Variant", "enumValues": ["pie", "donut"], "default": "donut" },
    "centerLabel": { "type": "string", "label": "Center label (donut only)" },
    "showPercents": { "type": "boolean", "label": "Show percent labels", "default": true },
    "title": { "type": "string", "label": "Title", "default": "Composition" },
    "output_path": { "type": "string", "label": "Output path", "help": "Defaults to data/outputs/<run>/<step>.png" }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "business", "composition", "pie", "donut"],
  "aliases": ["doughnut", "pie chart", "ring chart"],
  "requires": [{"kind": "any"}, {"kind": "numeric"}]
}
