{
  "id": "funnel_chart",
  "version": "1.0.0",
  "label": "📈 Funnel chart",
  "description": "Sequential conversion-funnel visualisation. Each row is a stage; the bar shrinks step-by-step. Drop-off labels show the percentage retained vs. the previous stage.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "stage": {
      "type": "column_ref", "label": "Stage column",
      "columnFrom": "in", "required": true
    },
    "value": {
      "type": "column_ref", "label": "Count / value column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["integer", "double"]
    },
    "title": {
      "type": "string", "label": "Title", "default": "Funnel"
    },
    "output_path": {
      "type": "string", "label": "Output path"
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "recommendedMaxRows": 30,
  "tags": ["chart", "business", "conversion"],
  "aliases": ["conversion funnel", "drop off"],
  "requires": [{"kind": "numeric"}]
}
