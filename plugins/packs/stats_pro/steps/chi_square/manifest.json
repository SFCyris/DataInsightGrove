{
  "id": "chi_square",
  "version": "1.0.0",
  "label": "📐 Chi-squared test",
  "description": "Chi-squared test of independence between two categorical columns. Builds the contingency table, returns chi² statistic, p-value, degrees of freedom, and Cramér's V effect size.",
  "category": "analyze",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "row": {
      "type": "column_ref",
      "label": "Row column",
      "columnFrom": "in",
      "required": true
    },
    "col": {
      "type": "column_ref",
      "label": "Column column",
      "columnFrom": "in",
      "required": true
    }
  },
  "preview": { "rowImpact": "may_reduce", "schemaImpact": "rebuilds" },
  "tags": ["statistics", "categorical"],
  "aliases": ["chi2", "chi-square", "independence", "association"],
  "requires": []
}
