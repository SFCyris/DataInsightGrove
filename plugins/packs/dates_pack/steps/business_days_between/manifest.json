{
  "id": "business_days_between",
  "version": "1.0.0",
  "label": "📅 Business days between",
  "description": "Count business days (Mon-Fri excluding holidays) between two date columns per row. Honours country-specific holiday calendars via the `holidays` library. Adds `bdays` column with the integer count.",
  "category": "derive",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "start_column": {
      "type": "column_ref", "label": "Start date column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["date", "datetime"]
    },
    "end_column": {
      "type": "column_ref", "label": "End date column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["date", "datetime"]
    },
    "country": {
      "type": "string", "label": "Country (ISO 3166 alpha-2)",
      "default": "US",
      "help": "US, GB, DE, FR, JP, etc. See https://python-holidays.readthedocs.io/."
    },
    "output_column": {
      "type": "string", "label": "Output column name", "default": "bdays"
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["dates", "business"],
  "aliases": ["working days", "weekday count", "networkdays"],
  "requires": [{"kind": "temporal", "min": 2}]
}
