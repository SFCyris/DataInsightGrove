{"id":"dp_aggregate_laplace","version":"1.0.0","label":"🔒 DP aggregate (Laplace)","description":"Sum a numeric column with Laplace noise calibrated to (epsilon, sensitivity) for ε-differential privacy. Use to publish aggregates without revealing per-row contributions.","category":"aggregate","engine":{"primary":"polars","browser":"none","deterministic":true},"io":{"inputs":{"min":1,"max":1,"ports":["in"]},"outputs":{"min":1,"max":1,"ports":["out"]}},"params":{"valueColumn":{"type":"column_ref","label":"Value column","columnFrom":"in","required":true,"columnTypes":["integer","double"]},"groupColumn":{"type":"column_ref","label":"Group column (optional)","columnFrom":"in"},"epsilon":{"type":"number","label":"Epsilon (privacy budget)","default":1.0,"min":0.01,"max":100.0},"sensitivity":{"type":"number","label":"Sensitivity (max single-row contribution)","required":true,"min":0.0001},"seed":{"type":"integer","label":"Random seed","default":42}},"preview":{"rowImpact":"may_reduce","schemaImpact":"rebuilds"},"tags":["privacy","dp","laplace","compliance"],"requires":[]}
