{"id":"sequential_sprt","version":"1.0.0","label":"⏯ Sequential SPRT","description":"Wald's Sequential Probability Ratio Test for early stopping. Two competing hypotheses (H0: p = p0, H1: p = p1); after each observation, the log-likelihood ratio either crosses an upper bound (accept H1) or lower bound (accept H0), or continues sampling.","category":"analyze","engine":{"primary":"polars","browser":"none","deterministic":true},"io":{"inputs":{"min":1,"max":1,"ports":["in"]},"outputs":{"min":1,"max":1,"ports":["out"]}},"params":{"convertedColumn":{"type":"column_ref","label":"Converted (0/1)","columnFrom":"in","required":true},"orderColumn":{"type":"column_ref","label":"Order (timestamp / row index)","columnFrom":"in","required":true},"p0":{"type":"number","label":"H0 conversion rate","required":true,"min":0.0001,"max":0.9999},"p1":{"type":"number","label":"H1 conversion rate","required":true,"min":0.0001,"max":0.9999},"alpha":{"type":"number","label":"Alpha","default":0.05,"min":0.001,"max":0.5},"beta":{"type":"number","label":"Beta","default":0.2,"min":0.001,"max":0.5}},"preview":{"rowImpact":"may_reduce","schemaImpact":"rebuilds"},"tags":["ab-test","sequential","sprt","early-stopping"],"requires":[]}
