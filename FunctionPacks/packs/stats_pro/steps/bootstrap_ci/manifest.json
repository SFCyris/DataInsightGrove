{
  "id": "bootstrap_ci",
  "version": "1.0.0",
  "label": "📐 Bootstrap CI",
  "description": "Distribution-free confidence interval around a statistic by resampling with replacement. Works when the data isn't normal and parametric CIs would lie. Returns mean/median estimate, lower bound, upper bound, and width at the requested confidence level.",
  "category": "analyze",
  "engine": { "primary": "polars", "browser": "none", "deterministic": false },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "value": {
      "type": "column_ref", "label": "Value column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["integer", "double"]
    },
    "statistic": {
      "type": "enum", "label": "Statistic",
      "enumValues": ["mean", "median", "std", "iqr"], "default": "mean"
    },
    "confidence": {
      "type": "number", "label": "Confidence level",
      "default": 0.95, "min": 0.5, "max": 0.999
    },
    "n_iter": {
      "type": "integer", "label": "Bootstrap iterations",
      "default": 2000, "min": 100, "max": 100000
    },
    "seed": {
      "type": "integer", "label": "Random seed",
      "default": 0,
      "help": "Set to a non-zero value for reproducible CIs."
    }
  },
  "preview": { "rowImpact": "may_reduce", "schemaImpact": "rebuilds" },
  "tags": ["statistics"],
  "aliases": ["bootstrap", "confidence interval", "resampling"],
  "requires": [{"kind": "numeric"}]
}
