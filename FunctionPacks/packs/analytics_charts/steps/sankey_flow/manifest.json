{
  "id": "sankey_flow",
  "version": "1.0.0",
  "label": "🌊 Sankey flow",
  "description": "Render data-flow Sankey from (source, target, value) edges. Use for user journeys, attribution flows, A/B test cohort transitions, supply chains, energy / material flows. Distinct from the lineage Sankey in the editor — this one renders a static PNG of your data.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "sourceColumn": { "type": "column_ref", "label": "Source node column", "columnFrom": "in", "required": true },
    "targetColumn": { "type": "column_ref", "label": "Target node column", "columnFrom": "in", "required": true },
    "valueColumn":  { "type": "column_ref", "label": "Edge value column",  "columnFrom": "in", "required": true,
      "help": "Numeric flow magnitude. Multiple rows with the same (source, target) are summed." },
    "title": { "type": "string", "label": "Title", "default": "Sankey flow" },
    "format": { "type": "enum", "label": "Format", "enumValues": ["png", "svg"], "default": "png", "required": true },
    "width":  { "type": "integer", "label": "Width (px)",  "default": 1600, "min": 200, "max": 4000 },
    "height": { "type": "integer", "label": "Height (px)", "default": 900,  "min": 200, "max": 4000 }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "sankey", "flow", "alluvial", "transitions"],
  "requires": [{"kind": "any"}, {"kind": "any"}, {"kind": "numeric"}],
  "aliases": ["alluvial", "flow diagram", "user journey"]
}
