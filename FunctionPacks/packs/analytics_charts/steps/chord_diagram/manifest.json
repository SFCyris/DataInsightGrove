{
  "id": "chord_diagram",
  "version": "1.0.0",
  "label": "🎻 Chord diagram",
  "description": "Circular relationship plot from a (source, target, value) edge list. Use for many-to-many flows where source and target draw from the same set of categories — international trade, social network ties, transaction graphs.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "sourceColumn": { "type": "column_ref", "label": "Source category column", "columnFrom": "in", "required": true },
    "targetColumn": { "type": "column_ref", "label": "Target category column", "columnFrom": "in", "required": true },
    "valueColumn":  { "type": "column_ref", "label": "Edge value column",      "columnFrom": "in", "required": true },
    "title": { "type": "string", "label": "Title", "default": "Chord diagram" },
    "format": { "type": "enum", "label": "Format", "enumValues": ["png", "svg"], "default": "png", "required": true },
    "width":  { "type": "integer", "label": "Width (px)",  "default": 1200, "min": 200, "max": 4000 },
    "height": { "type": "integer", "label": "Height (px)", "default": 1200, "min": 200, "max": 4000 }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "chord", "network", "relationships"],
  "requires": [{"kind": "any"}, {"kind": "any"}, {"kind": "numeric"}],
  "aliases": ["circular flow", "network ring"]
}
