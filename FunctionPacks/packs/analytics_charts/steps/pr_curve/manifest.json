{
  "id": "pr_curve",
  "version": "1.0.0",
  "label": "📉 Precision-Recall curve",
  "description": "Render a Precision-Recall curve with average-precision (AP) reported in the legend. Better than ROC when the positive class is rare (fraud, churn, anomaly). Pairs with logistic_regression.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "actualColumn": { "type": "column_ref", "label": "Actual (true class) column", "columnFrom": "in", "required": true },
    "probaColumn": { "type": "column_ref", "label": "Predicted probability column", "columnFrom": "in", "required": true },
    "title": { "type": "string", "label": "Title", "default": "Precision-Recall Curve" },
    "format": { "type": "enum", "label": "Format", "enumValues": ["png", "svg"], "default": "png", "required": true },
    "width":  { "type": "integer", "label": "Width (px)",  "default": 1000, "min": 200, "max": 4000 },
    "height": { "type": "integer", "label": "Height (px)", "default": 800,  "min": 200, "max": 4000 }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "classification", "ml", "precision", "recall", "average precision"],
  "requires": [{"kind": "numeric"}, {"kind": "numeric"}],
  "aliases": ["pr curve", "precision recall", "average precision", "AP score"]
}
