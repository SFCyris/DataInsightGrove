{
  "id": "churn_lite",
  "version": "1.0.0",
  "label": "🚪 Churn lite",
  "description": "Lightweight churn flag based on inactivity. A customer is marked churned if their last transaction is older than `windowDays` from the as-of date. Use as a fast labelling pass before training a real churn model.",
  "category": "derive",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "customerColumn": { "type": "column_ref", "label": "Customer ID column", "columnFrom": "in", "required": true },
    "dateColumn":     { "type": "column_ref", "label": "Transaction date column", "columnFrom": "in", "required": true },
    "windowDays":     { "type": "integer", "label": "Inactivity window (days)", "default": 90, "min": 1, "max": 3650 },
    "asOfDate": { "type": "string", "label": "As-of date (YYYY-MM-DD; today if blank)" }
  },
  "preview": { "rowImpact": "may_reduce", "schemaImpact": "rebuilds" },
  "tags": ["churn", "rfm", "marketing", "label"],
  "aliases": ["churn flag", "inactive customers", "lapsed"],
  "requires": [{"kind": "any"}, {"kind": "temporal"}]
}
