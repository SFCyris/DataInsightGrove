{"id":"undersample","version":"1.0.0","label":"📉 Undersample majority","description":"Randomly drop rows from the majority class until classes are balanced (or to a target ratio). Faster + simpler than SMOTE when you have plenty of majority-class data.","category":"clean","engine":{"primary":"polars","browser":"none","deterministic":true},"io":{"inputs":{"min":1,"max":1,"ports":["in"]},"outputs":{"min":1,"max":1,"ports":["out"]}},"params":{"targetColumn":{"type":"column_ref","label":"Target (class) column","columnFrom":"in","required":true},"ratio":{"type":"number","label":"Majority:minority ratio (1.0 = balanced)","default":1.0,"min":0.1,"max":10.0},"seed":{"type":"integer","label":"Random seed","default":42}},"preview":{"rowImpact":"may_reduce","schemaImpact":"preserves"},"tags":["sampling","imbalanced","undersample","ml"],"requires":[]}
