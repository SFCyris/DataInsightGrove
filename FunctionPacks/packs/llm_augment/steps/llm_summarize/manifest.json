{
  "id": "llm_summarize",
  "version": "1.0.0",
  "label": "✨ LLM summarize",
  "description": "Add a `summary` column with a short LLM-generated summary of each row's text. One LLM call per row. Use sample_rows for prototyping; on full datasets the cost can be material.",
  "category": "derive",
  "engine": { "primary": "polars", "browser": "none", "deterministic": false },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "text_column": {
      "type": "column_ref", "label": "Text column",
      "columnFrom": "in", "required": true
    },
    "max_words": {
      "type": "integer", "label": "Max words in summary",
      "default": 30, "min": 5, "max": 500
    },
    "output_column": {
      "type": "string", "label": "Output column", "default": "summary"
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["ai", "llm"],
  "aliases": ["summarize", "tldr", "condense"],
  "requires": [{"kind": "string"}]
}
