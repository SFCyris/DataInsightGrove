{
  "id": "validate_iban",
  "version": "1.0.0",
  "label": "🏦 Validate IBAN",
  "description": "Validate International Bank Account Numbers (ISO 13616). Adds `iban_valid`, `iban_country`, `iban_bank_code`, and `iban_account` columns. Uses the schwifty library which knows the per-country IBAN format rules + checksum.",
  "category": "clean",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "iban_column": {
      "type": "column_ref", "label": "IBAN column",
      "columnFrom": "in", "required": true
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["formats", "finance", "banking"],
  "aliases": ["iban", "bank account", "iso 13616"],
  "requires": [{"kind": "string"}]
}
