{
  "id": "impute_mean_median_mode",
  "version": "1.0.0",
  "label": "🩹 Impute mean / median / mode",
  "description": "Fill nulls in selected columns with the per-column statistic (mean, median, or mode). Default behaviour: numeric columns use median, categorical/string columns use mode.",
  "category": "clean",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "columns": { "type": "column_refs", "label": "Columns to impute", "columnFrom": "in", "required": true },
    "strategy": {
      "type": "enum", "label": "Strategy",
      "enumValues": ["auto", "mean", "median", "mode"], "default": "auto",
      "help": "auto = numeric→median, non-numeric→mode."
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["imputation", "missing", "fill", "clean"],
  "aliases": ["fill nulls", "fillna", "missing value imputation"],
  "requires": []
}
