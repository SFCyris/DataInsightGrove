{
  "id": "violin_plot",
  "version": "1.0.0",
  "label": "📊 Violin plot",
  "description": "Violin plot — KDE distribution + box-plot hybrid. Shows the SHAPE of the distribution (bimodality, skew, fat tails) that a box plot hides. Optionally split by a categorical group column.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "value": {
      "type": "column_ref", "label": "Value column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["integer", "double"]
    },
    "group": {
      "type": "column_ref", "label": "Group column (optional)", "columnFrom": "in"
    },
    "title": {
      "type": "string", "label": "Title", "default": "Violin plot"
    },
    "output_path": {
      "type": "string", "label": "Output path"
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "diagnostic"],
  "aliases": ["violin", "kde", "distribution shape"],
  "requires": [{"kind": "numeric"}]
}
