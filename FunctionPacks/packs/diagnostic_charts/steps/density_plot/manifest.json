{
  "id": "density_plot",
  "version": "1.0.0",
  "label": "📈 Density plot",
  "description": "Smooth distribution via Gaussian KDE. Use when N is large enough that histogram bin choice starts to dominate the appearance of the data. Optional grouping draws one curve per category.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "value": {
      "type": "column_ref", "label": "Value column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["integer", "double"]
    },
    "group": {
      "type": "column_ref", "label": "Group column (optional)", "columnFrom": "in",
      "help": "Draw one density curve per category in this column."
    },
    "fill": { "type": "boolean", "label": "Fill under curve", "default": true },
    "title": { "type": "string", "label": "Title", "default": "Density" },
    "output_path": { "type": "string", "label": "Output path", "help": "Defaults to data/outputs/<run>/<step>.png" }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "diagnostic", "kde", "density"],
  "aliases": ["kde", "kernel density", "smooth histogram"],
  "requires": [{"kind": "numeric"}]
}
