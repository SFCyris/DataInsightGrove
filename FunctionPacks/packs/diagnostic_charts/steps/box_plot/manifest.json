{
  "id": "box_plot",
  "version": "1.0.0",
  "label": "📊 Box plot",
  "description": "Render a box-whisker plot of one numeric column, optionally split by a categorical group column. Shows median, quartiles, whiskers, and outlier dots — distribution shape at a glance.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "value": {
      "type": "column_ref", "label": "Value column",
      "columnFrom": "in", "required": true,
      "columnTypes": ["integer", "double"]
    },
    "group": {
      "type": "column_ref", "label": "Group column (optional)", "columnFrom": "in"
    },
    "title": {
      "type": "string", "label": "Title", "default": "Box plot"
    },
    "output_path": {
      "type": "string", "label": "Output path",
      "help": "Defaults to data/outputs/<run>/<step>.png"
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "diagnostic"],
  "aliases": ["boxplot", "box-whisker", "iqr plot"],
  "requires": [{"kind": "numeric"}]
}
