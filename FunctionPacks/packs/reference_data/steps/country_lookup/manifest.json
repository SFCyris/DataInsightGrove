{
  "id": "country_lookup",
  "version": "1.0.0",
  "label": "🌍 Country lookup",
  "description": "Resolve a country column (alpha-2 / alpha-3 / numeric code / common name) into its canonical ISO 3166 record. Adds `country_alpha2`, `country_alpha3`, `country_name`, `country_numeric`, and `country_official` columns.",
  "category": "derive",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "country_column": {
      "type": "column_ref", "label": "Country column",
      "columnFrom": "in", "required": true
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["reference", "iso"],
  "aliases": ["iso 3166", "country code", "country name"],
  "requires": []
}
