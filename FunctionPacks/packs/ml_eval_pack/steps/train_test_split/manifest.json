{
  "id": "train_test_split",
  "version": "1.0.0",
  "label": "🧪 Train/test split",
  "description": "Add a `split` column tagging each row as `train` or `test`. Optionally stratifies by a categorical column so the train and test sets have the same class balance.",
  "category": "validate",
  "engine": { "primary": "polars", "browser": "none", "deterministic": false },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "test_size": {
      "type": "number", "label": "Test fraction",
      "default": 0.2, "min": 0.05, "max": 0.5
    },
    "stratify_by": {
      "type": "column_ref", "label": "Stratify by (optional)", "columnFrom": "in"
    },
    "seed": {
      "type": "integer", "label": "Random seed", "default": 42
    },
    "output_column": {
      "type": "string", "label": "Output column name", "default": "split"
    }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "modifies" },
  "tags": ["ml", "evaluation"],
  "aliases": ["holdout", "train test", "split"],
  "requires": []
}
