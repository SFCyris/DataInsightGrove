{
  "id": "lift_chart",
  "version": "1.0.0",
  "label": "📊 Lift chart",
  "description": "How much better than random is the model at each cumulative percentile? Y-axis: ratio of (positives captured by top X%) / (random baseline). Lift = 1 means random performance; lift > 2 at 10% means the model is twice as effective as random in the top decile.",
  "category": "visualize",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "actualColumn": { "type": "column_ref", "label": "Actual (true class) column", "columnFrom": "in", "required": true },
    "probaColumn":  { "type": "column_ref", "label": "Predicted probability column", "columnFrom": "in", "required": true },
    "buckets":      { "type": "integer", "label": "Number of buckets (deciles by default)", "default": 10, "min": 2, "max": 100 },
    "title": { "type": "string", "label": "Title", "default": "Lift chart" },
    "output_path": { "type": "string", "label": "Output path", "help": "Defaults to data/outputs/<run>/<step>.png" }
  },
  "preview": { "rowImpact": "preserves", "schemaImpact": "preserves" },
  "tags": ["chart", "ml", "evaluation", "lift", "uplift"],
  "aliases": ["uplift chart", "decile lift", "performance ratio"],
  "requires": [{"kind": "any"}, {"kind": "numeric"}]
}
