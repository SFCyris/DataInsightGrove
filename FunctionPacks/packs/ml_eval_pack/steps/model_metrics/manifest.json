{
  "id": "model_metrics",
  "version": "1.0.0",
  "label": "🧪 Model metrics",
  "description": "Compute evaluation metrics by comparing actual and predicted columns. Auto-detects regression vs. classification from the actual column's type. Returns a one-row DataFrame with the appropriate metrics.",
  "category": "validate",
  "engine": { "primary": "polars", "browser": "none", "deterministic": true },
  "io": {
    "inputs": { "min": 1, "max": 1, "ports": ["in"] },
    "outputs": { "min": 1, "max": 1, "ports": ["out"] }
  },
  "params": {
    "actual": {
      "type": "column_ref", "label": "Actual column",
      "columnFrom": "in", "required": true
    },
    "predicted": {
      "type": "column_ref", "label": "Predicted column",
      "columnFrom": "in", "required": true
    },
    "task": {
      "type": "enum", "label": "Task",
      "enumValues": ["auto", "regression", "classification"],
      "default": "auto"
    },
    "probability_column": {
      "type": "column_ref", "label": "Probability column (classification, optional)",
      "columnFrom": "in",
      "help": "If set + task is classification, also computes ROC AUC and log loss."
    }
  },
  "preview": { "rowImpact": "may_reduce", "schemaImpact": "rebuilds" },
  "tags": ["ml", "evaluation", "metrics"],
  "aliases": ["rmse", "mae", "auc", "f1", "accuracy", "model evaluation"],
  "requires": []
}
