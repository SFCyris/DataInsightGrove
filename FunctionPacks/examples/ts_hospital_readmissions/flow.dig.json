{
  "schemaVersion": 1,
  "id": "ts_hospital_readmissions_demo",
  "name": "\ud83c\udfe5 Healthcare \u00b7 readmission rate trend + intervention",
  "description": "Decompose into trend / seasonal / residual, then run changepoint detection. The intervention drop should fire as a clear changepoint around month 30.",
  "datasets": [
    {
      "id": "{{DATASET_ID}}",
      "connector": "parquet",
      "uri": "{{DATASET_URI}}",
      "label": "48 months of hospital readmission rates with a quality-improvement intervention at month 30"
    }
  ],
  "nodes": [
    {
      "id": "n_decomp",
      "step": "seasonal_decompose",
      "stepVersion": "1.0.0",
      "inputs": {
        "in": {
          "ref": "{{DATASET_ID}}"
        }
      },
      "outputs": [
        "out"
      ],
      "params": {
        "time_column": "month",
        "value_column": "readmission_rate_pct",
        "model": "additive",
        "period": 12,
        "render": true,
        "title": "Readmission rate \u00b7 decomposition"
      },
      "ui": {
        "x": 300,
        "y": 80,
        "label": "Decompose \u00b7 12m period"
      }
    },
    {
      "id": "n_cp",
      "step": "changepoint_detection",
      "stepVersion": "1.0.0",
      "inputs": {
        "in": {
          "ref": "{{DATASET_ID}}"
        }
      },
      "outputs": [
        "out"
      ],
      "params": {
        "value": "readmission_rate_pct",
        "threshold": 4.0
      },
      "ui": {
        "x": 300,
        "y": 240,
        "label": "Changepoint \u00b7 4\u03c3"
      }
    }
  ],
  "outputs": []
}