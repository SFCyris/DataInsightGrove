{
  "schemaVersion": 1,
  "id": "ts_housing_inventory_anomaly_demo",
  "name": "\ud83c\udfe0 Housing \u00b7 inventory crunch detection",
  "description": "Decompose then z-score the residuals. The crunch period (weeks 80-110) and recovery (111-130) light up as multi-week anomaly windows.",
  "datasets": [
    {
      "id": "{{DATASET_ID}}",
      "connector": "parquet",
      "uri": "{{DATASET_URI}}",
      "label": "3 years of weekly active listings with a 30-week supply crunch + slow recovery"
    }
  ],
  "nodes": [
    {
      "id": "n_decomp",
      "step": "seasonal_decompose",
      "stepVersion": "1.0.0",
      "inputs": {
        "in": {
          "ref": "{{DATASET_ID}}"
        }
      },
      "outputs": [
        "out"
      ],
      "params": {
        "time_column": "week",
        "value_column": "active_listings",
        "model": "additive",
        "period": 52,
        "render": true,
        "title": "Housing inventory \u00b7 decomposition"
      },
      "ui": {
        "x": 300,
        "y": 80,
        "label": "Decompose \u00b7 52w period"
      }
    },
    {
      "id": "n_anomaly",
      "step": "anomaly_zscore",
      "stepVersion": "1.0.0",
      "inputs": {
        "in": {
          "ref": "{{DATASET_ID}}"
        }
      },
      "outputs": [
        "out"
      ],
      "params": {
        "value": "active_listings",
        "window": 8,
        "threshold": 2.5,
        "min_periods": 4
      },
      "ui": {
        "x": 300,
        "y": 240,
        "label": "Z-score on raw \u00b7 8w window"
      }
    },
    {
      "id": "n_cp",
      "step": "changepoint_detection",
      "stepVersion": "1.0.0",
      "inputs": {
        "in": {
          "ref": "{{DATASET_ID}}"
        }
      },
      "outputs": [
        "out"
      ],
      "params": {
        "value": "active_listings",
        "threshold": 4.0
      },
      "ui": {
        "x": 300,
        "y": 400,
        "label": "Changepoint \u00b7 4\u03c3"
      }
    }
  ],
  "outputs": []
}